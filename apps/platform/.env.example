# Copiar a .env.local y completar. Nunca commitear .env.local.
# ⚠️ No usar el prefijo VITE_ en ninguna de estas variables: Vite las expondría al navegador.

# --- Supabase ---
# Local: valores que imprime `pnpm db:start` (o `pnpm exec supabase status`):
#   ANON_KEY → SUPABASE_ANON_KEY, SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY.
# Nube: Project Settings → API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Solo servidor. Únicamente la usa src/server/db/debtor-access.ts (PLAN_BACKEND §3.3).
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (gateway u openrouter; configuración exclusiva del servidor) ---
AI_PROVIDER=gateway
# Vercel → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=
# OpenRouter → Keys. Se usa únicamente cuando AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# ID exacto del proveedor seleccionado, formato "proveedor/modelo".
# El modelo elegido debe soportar tool calling y streaming.
AI_MODEL=

# --- Sesión del deudor ---
# Secreto para firmar la cookie post-verificación (PLAN_BACKEND D4).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEGOTIATION_TOKEN_SECRET=
